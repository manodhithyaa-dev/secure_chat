# SecureChat server configuration
# Copy to server/.env (or root .env) and adjust as needed.

# Port the Express + Socket.IO server listens on
PORT=4000

# Directory for the SQLite database file (relative to server/ or absolute)
DATA_DIR=./data
DATABASE_FILE=./data/securechat.sqlite

# Comma-separated list of allowed CORS origins for the API
CORS_ORIGIN=http://localhost:5173

# Mark the session cookie Secure. Defaults to true when NODE_ENV=production.
# Set to false to run production behind plain HTTP (e.g. local Docker without
# TLS); set to true when TLS is terminated in front of the app.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Tailscale deployment (see docs/DEPLOYMENT.md)
# ---------------------------------------------------------------------------
# When publishing to your tailnet with `tailscale serve`, set CORS_ORIGIN to
# the exact https origin and enable Secure cookies:
#   CORS_ORIGIN=https://securechat.<tailnet>.ts.net
#   COOKIE_SECURE=true
#
# WebRTC ICE servers (audio/video calls). On a tailnet, peers are directly
# reachable, so STUN is optional. Leave unset for the default Google STUN, or
# set an empty value to disable STUN entirely:
#   RTC_STUN_SERVERS=
# A TURN relay is usually unnecessary on a tailnet; set these only if needed.
#   RTC_TURN_URL=turn:turn.example.com:3478
#   RTC_TURN_USERNAME=
#   RTC_TURN_CREDENTIAL=

# Session lifetime in milliseconds (default 7 days)
SESSION_TTL_MS=604800000

# Offline message queue expiry in milliseconds (default 7 days)
MESSAGE_TTL_MS=604800000

# Interval for the expired-message cleanup job in milliseconds (default 1 hour)
CLEANUP_INTERVAL_MS=3600000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Node environment
NODE_ENV=development

# Frontend (Vite) - only used if you want to override the dev proxy target
VITE_API_PROXY_TARGET=http://localhost:4000
